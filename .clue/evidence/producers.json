{
  "producers": [
    {
      "id": "bridge-junit",
      "framework": "JUnit",
      "language": "Java",
      "include": [
        ".clue/evidence/aggregate.py",
        ".clue/evidence/junit_producer.py",
        "build.gradle.kts",
        "*/build.gradle.kts",
        "*/src/test/java/**/*.java",
        "compat-test/conformance-robots/**/*.java",
        "compat-test/conformance-robots/**/*.team"
      ],
      "command": [
        "python",
        ".clue/evidence/junit_producer.py"
      ],
      "exclude": [
        ".agents",
        ".claude",
        ".git",
        ".gradle",
        "**/build",
        "**/.gradle"
      ]
    }
  ]
}
